design_purpose = {
"crown_taper": "Reduce the upper branches and crowns into a recognisable conifer outline; zero keeps broadleaf spread.",
"pointed": "Conifer crowns rise to a tip instead of a broad flattened upper surface.",
"height": "Crown height in local metres; trees keep their existing world scale and harvesting origin.",
"trunk_radius": "Visible trunk girth within the existing trunk collider.",
"lean": "Sideways drift at the crown, making trunks less pole-like.",
"branches": "Number of staggered crown-bearing branches; controls silhouette density and mesh cost.",
"spread": "Branch reach: broad open meadow trees, tight forest trees, spreading fen trees.",
"branch_rise": "How steeply each branch rises from its fork.",
"crown_radius": "Width of each overlapping foliage mass; zero makes a bare snag.",
"crown_depth": "Crown thickness; low fen crowns and deeper forest foliage.",
"bark": "Bark shades drawn from the master bark/loam palette.",
"leaf": "Sunward foliage colour drawn from or mixed between master grass/leaf tones.",
"leaf_dark": "Dark underside gives the crown depth without random face noise.",
"radial_segments": "Nine sides per foliage ring keep a carved silhouette with broad surfaces."
}
