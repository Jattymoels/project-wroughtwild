# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
.import/
export.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Godot extracts these original grain textures from the curated Cataclysm GLBs.
# The authoring source and embedded images remain authoritative.
/assets/authored/cataclysm_*_Cataclysm * grain.png
/assets/authored/cataclysm_*_Cataclysm * grain.png.import
